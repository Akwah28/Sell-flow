{
  "entities": {
    "BusinessProfile": {
      "title": "Business Profile",
      "description": "User business settings and WhatsApp credentials",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "description": { "type": "string" },
        "currency": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "whatsappToken": { "type": "string" },
        "whatsappPhoneId": { "type": "string" },
        "whatsappBusinessAccountId": { "type": "string" },
        "storeSlug": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "views": { "type": "number" },
        "clicksMessageMerchant": { "type": "number" },
        "clicksWhatsAppOrder": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "whatsappNumber", "storeSlug", "ownerId"]
    },
    "Product": {
      "title": "Product",
      "description": "Product in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["physical", "digital", "service"] },
        "isActive": { "type": "boolean" },
        "stock": { "type": "number" },
        "ownerId": { "type": "string" },
        "isBestSeller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isPromotion": { "type": "boolean" },
        "inventoryStatus": { "type": "string", "enum": ["in_stock", "low_stock", "out_of_stock"] }
      },
      "required": ["name", "price", "type", "ownerId", "isActive"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Potential customer lead",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "source": { "type": "string" },
        "interest": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "interested", "paid", "lost"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "phone", "status", "ownerId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "leadId": { "type": "string" },
        "productId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "fulfillmentStatus": { "type": "string", "enum": ["pending", "paid", "processing", "delivered", "completed"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["leadId", "productId", "amount", "paymentStatus", "fulfillmentStatus", "createdAt", "ownerId"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["productId", "customerName", "rating", "comment", "createdAt", "ownerId"]
    },
    "SlugMapping": {
      "title": "Slug Mapping",
      "description": "Public map of storefront slugs to their business owners",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "businessName": { "type": "string" }
      },
      "required": ["ownerId", "businessName"]
    },
    "PlatformReview": {
      "title": "Platform Review",
      "description": "Nicest way review left by users for the platform",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "rating", "content", "createdAt"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Messages sent from visitors on the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "businessType": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "AdminProfile": {
      "title": "Admin Profile",
      "description": "System administrator user records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "Customer support request ticket",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "assigned"] },
        "assigneeId": { "type": "string" },
        "assigneeName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "replies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender": { "type": "string" },
              "message": { "type": "string" },
              "createdAt": { "type": "string" }
            }
          }
        }
      },
      "required": ["customerName", "email", "subject", "message", "status", "createdAt"]
    },
    "FraudAlert": {
      "title": "Fraud Alert",
      "description": "Automated security or fraud flag detection",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["fake_accounts", "spam_products", "login_attempts", "sales_spikes"] },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["active", "resolved"] },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "description", "severity", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable records of administrator actions",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["adminId", "adminEmail", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/slugs/{slug}": {
      "schema": "SlugMapping",
      "description": "Mapping from storefront slug to business owner UID"
    },
    "/businesses/{businessId}": {
      "schema": "BusinessProfile",
      "description": "Business settings for each user"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products listed by businesses"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Sales leads for each business"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "/platform_reviews/{reviewId}": {
      "schema": "PlatformReview",
      "description": "Reviews left by users for the platform itself"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Contact form submissions"
    },
    "/admins/{adminId}": {
      "schema": "AdminProfile",
      "description": "System administrator user records"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support requests"
    },
    "/fraud_alerts/{alertId}": {
      "schema": "FraudAlert",
      "description": "Automated system and transaction flags"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin action history logs"
    }
  }
}
