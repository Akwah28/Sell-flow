rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. REUSABLE HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(data) { return isSignedIn() && data.ownerId == request.auth.uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() { 
      return isSignedIn() 
        && request.auth.token.email == 'godgiftakwah28@gmail.com' 
        && request.auth.token.email_verified == true; 
    }

    // --- 2. VALIDATION BLUEPRINTS ---

    function isValidBusiness(data) {
      return data.keys().hasAll(['name', 'description', 'currency', 'whatsappNumber', 'storeSlug', 'isVerified', 'ownerId'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.currency is string && data.currency.size() == 3
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 30
        && data.storeSlug is string && data.storeSlug.size() > 0 && data.storeSlug.size() <= 50
        && data.isVerified is bool
        && data.ownerId is string && data.ownerId.size() > 0
        && (data.get('logo', '') is string && data.get('logo', '').size() <= 1000)
        && (data.get('whatsappToken', '') is string && data.get('whatsappToken', '').size() <= 2000)
        && (data.get('whatsappPhoneId', '') is string && data.get('whatsappPhoneId', '').size() <= 100)
        && (data.get('whatsappBusinessAccountId', '') is string && data.get('whatsappBusinessAccountId', '').size() <= 100)
        && (data.get('metaTitle', '') is string && data.get('metaTitle', '').size() <= 100)
        && (data.get('metaDescription', '') is string && data.get('metaDescription', '').size() <= 300);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'type', 'ownerId', 'isActive'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.type in ['physical', 'digital', 'service']
        && data.ownerId is string && data.ownerId.size() > 0
        && data.isActive is bool
        && (data.get('images', []).size() <= 10);
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'phone', 'status', 'ownerId', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && data.status in ['new', 'contacted', 'interested', 'paid', 'lost']
        && data.ownerId is string && data.ownerId.size() > 0
        && exists(/databases/$(database)/documents/businesses/$(data.ownerId));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['leadId', 'productId', 'amount', 'paymentStatus', 'fulfillmentStatus', 'createdAt', 'ownerId'])
        && data.leadId is string && data.productId is string
        && data.amount is number && data.amount >= 0
        && data.paymentStatus in ['pending', 'paid']
        && data.fulfillmentStatus in ['pending', 'paid', 'processing', 'delivered', 'completed']
        && data.ownerId is string && data.ownerId.size() > 0
        && exists(/databases/$(database)/documents/businesses/$(data.ownerId));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'customerName', 'rating', 'comment', 'createdAt', 'ownerId'])
        && data.productId is string && data.customerName is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && data.ownerId is string && data.ownerId.size() > 0
        && exists(/databases/$(database)/documents/businesses/$(data.ownerId));
    }

    // --- 3. COLLECTIONS ---

    match /businesses/{businessId} {
      allow get: if true; // Publicly readable for storefront
      allow create: if isSignedIn() && request.auth.uid == businessId && isValidBusiness(incoming());
      allow update: if isSignedIn() && request.auth.uid == businessId && isValidBusiness(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'currency', 'whatsappNumber', 'whatsappToken', 'whatsappPhoneId', 'whatsappBusinessAccountId', 'storeSlug', 'metaTitle', 'metaDescription']) || isAdmin());
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if true;
      allow list: if (resource.data.isActive == true) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidProduct(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing()) && isValidProduct(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing());
    }

    match /leads/{leadId} {
      allow get: if isOwner(existing());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      // Allow creation from anyone (storefront)
      allow create: if isValidLead(incoming());
      allow update: if isOwner(existing()) && isValidLead(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing());
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing()) && isValidOrder(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if true; // Reviews are public
      allow create: if isValidReview(incoming());
      allow update, delete: if isOwner(existing());
    }
  }
}
